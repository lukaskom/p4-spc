# ──────────────────────────────────────────────────────────────
# p4-spc — environment variables
# ──────────────────────────────────────────────────────────────
# Zkopíruj jako .env a vyplň. .env není v gitu (viz .gitignore).

# ─── Node ─────────────────────────────────────────────────────
NODE_ENV=development

# ─── Local services (docker-compose) ──────────────────────────
# Pozn.: pro lokální dev není potřeba měnit. Pro cloud se odkazuje do Key Vaultu.

POSTGRES_USER=p4spc
POSTGRES_PASSWORD=p4spc_dev
POSTGRES_DB=p4spc_control
POSTGRES_PORT=5432

REDIS_PORT=6379

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ─── Control-plane DB ─────────────────────────────────────────
CONTROL_PLANE_DATABASE_URL=postgresql://p4spc:p4spc_dev@localhost:5432/p4spc_control?schema=public

# ─── Data-plane DB connection template ────────────────────────
# {tenantDb} je placeholder, který runtime nahradí podle tenant kontextu.
# V produkci ukládáme DSN per tenant v control-plane; tohle je dev fallback.
DATA_PLANE_DATABASE_URL_TEMPLATE=postgresql://p4spc:p4spc_dev@localhost:5432/{tenantDb}?schema=public

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ──────────────────────────────────────────────────────
API_PORT=3100
API_BASE_URL=http://localhost:3100
API_CORS_ORIGINS=http://localhost:5173

# ─── Auth ─────────────────────────────────────────────────────
# Vygeneruj dev hodnoty: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-session-secret
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
ARGON2_PEPPER=change-me-dev-only-argon2-pepper

# OAuth (vyplnit, když budeme testovat social login)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# ─── Email (lokálně Mailhog, v cloudu SMTP od Postmark/SendGrid) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="p4-spc <no-reply@p4-spc.local>"

# ─── Blob storage (lokálně lze skip, jde do tmp/) ────────────
# V Azure se plní přes Managed Identity — tady jen dev fallback.
BLOB_STORAGE_PROVIDER=local
BLOB_LOCAL_PATH=./tmp/blobs

# ─── Observability ────────────────────────────────────────────
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=p4-spc-api
