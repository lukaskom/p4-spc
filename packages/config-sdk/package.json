    "test": "vitest run"
  },
  "dependencies": {
    "@p4-spc/aqdef-core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
